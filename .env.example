# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Execução local (venv + Postgres nativo)
DATABASE_URL=postgresql://postgres:SENHA_AQUI@localhost:5432/logtrack
SECRET_KEY=gere_com_python_-c_"import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Usadas apenas pelo docker-compose.yml (banco/backend em container)
POSTGRES_PASSWORD=SENHA_DO_POSTGRES_NO_DOCKER
DOCKER_DATABASE_URL=postgresql://postgres:SENHA_DO_POSTGRES_NO_DOCKER@db:5432/logtrack
